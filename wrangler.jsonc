{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vamp",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "exports": {
    "Room": { "type": "durable-object", "storage": "sqlite" },
  },
}
